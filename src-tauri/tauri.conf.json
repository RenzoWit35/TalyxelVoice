{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalyxelVoice",
  "version": "0.4.1",
  "identifier": "com.talyxel.voice",
  "build": {
    "beforeDevCommand": "npm run fetch-llama && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch-llama && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "TalyxelVoice",
        "url": "index.html",
        "width": 880,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520
      },
      {
        "label": "pill",
        "title": "TalyxelVoice",
        "url": "pill.html",
        "width": 240,
        "height": 52,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "llama/*": "llama/",
      "vulkan/*": "vulkan/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQzE5QTlCNzM1QTJBRDgKUldUWUtscHptNXJCanRCOWNpSmJFbTlocDBPZm5oT2ZaMjFycXVMZ3hNelBVVXJEcmRuWS85cWQK",
      "endpoints": [
        "https://github.com/RenzoWit35/TalyxelVoice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
